{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Neram",
    "version": "0.1.3",
    "identifier": "Neram",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:3000",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "active": false,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRTJCQURGNjhBMzRCRDEKUldUUlM2Tm8zN3JpKzZSTnQzTWo1TU9KSktGMUwzM0cvb0dGeURPbmg1M1pKVGY1aUR2bmZxbWYK",
            "endpoints": [
                "https://athithianv.github.io/neram-updates/latest.json"
            ],
            "windows": {
                "installMode": "basicUi"
            }
        }
    }
}
